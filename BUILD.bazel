"""
BUILD.bazel for @tummycrypt/tinyland-a11y-engine.

Bazel is the build and distribution authority (RU6, RU8).
  Build: bazel build //:pkg
  Test:  bazel test //...
  Consumers: bazel_dep(name = "tummycrypt_tinyland_a11y_engine", version = "1.0.0")
             from xoxd-ai/bazel-registry, linked with
             npm_link_package(name = "node_modules/@tummycrypt/tinyland-a11y-engine",
                              src = "@tummycrypt_tinyland_a11y_engine//:pkg").
             The package is not published to npm.
"""

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_a11y_engine_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_a11y_engine_npm//:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

# First-party dep resolved through the Bazel module graph (not npm).
# tinyland-color-utils is linked from its registry module's :pkg target, and it
# is absent from package.json so npm_link_all_packages does not also link it.
npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-color-utils",
    src = "@tummycrypt_tinyland_color_utils//:pkg",
)

# Build-time deps: the optional peers (svelte, axe-core), @types/node and the
# in-house color-utils module.
BUILD_DEPS = [
    ":node_modules",
    ":node_modules/@types/node",
    ":node_modules/svelte",
    ":node_modules/axe-core",
    ":node_modules/@tummycrypt/tinyland-color-utils",
]

ts_project(
    name = "tinyland_a11y_engine",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = BUILD_DEPS,
    visibility = ["//visibility:public"],
)

# The compiled files only. A filegroup forwards files and drops the
# ts_project's JsInfo, so the build-time peers (svelte, axe-core) from this
# module's own lock are never linked into consumers; Node resolves them from
# the consuming app's single pnpm lock (RU9; U1 Bazel finding N1).
filegroup(
    name = "dist_js",
    srcs = [":tinyland_a11y_engine"],
)

filegroup(
    name = "dist_types",
    srcs = [":tinyland_a11y_engine"],
    output_group = "types",
)

# The one runtime dependency, color-utils (re-exported by ./color), travels
# with the package: js_library propagates its npm_package_store_info, so a
# consumer's npm_link_package links it next to this package.
js_library(
    name = "dist",
    srcs = [
        ":dist_js",
        ":dist_types",
    ],
    deps = [":node_modules/@tummycrypt/tinyland-color-utils"],
)

npm_package(
    name = "pkg",
    srcs = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "package.json",
        ":dist",
    ],
    # Ship the compiled files and docs only, never runfiles (node_modules).
    include_runfiles = False,
    package = "@tummycrypt/tinyland-a11y-engine",
    version = "1.0.0",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "test",
    data = [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
        ":node_modules/vitest",
        ":node_modules/happy-dom",
    ] + BUILD_DEPS + glob(["src/**/*.ts"]) + glob(["tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts"]) + ["package.json"],
    declaration = False,
    no_emit = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = BUILD_DEPS,
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
